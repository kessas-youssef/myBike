# MongoDB Atlas connection string. The app also accepts DB_STRING for backwards compatibility.
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/myBike?retryWrites=true&w=majority
MONGODB_DB=myBike

# Long random string used to sign the session cookie. Change it in production.
JWT_SECRET=replace-with-a-long-random-secret

# First admin account created automatically when the database is empty.
ADMIN_EMAIL=djo@mybike.dz
ADMIN_PASSWORD=replace-with-a-strong-password
